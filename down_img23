    // ===== Apply saved positions =====
    function applySavedPos(el, pos) {
        if (!pos) return;
        const w = el.offsetWidth || 56;
        const h = el.offsetHeight || 56;
        const x = Math.max(0, Math.min(window.innerWidth - w, pos.x));
        const y = Math.max(0, Math.min(window.innerHeight - h, pos.y));
        el.style.setProperty('left', x + 'px', 'important');
        el.style.setProperty('top', y + 'px', 'important');
        el.style.setProperty('right', 'auto', 'important');
        el.style.setProperty('bottom', 'auto', 'important');
    }

    // Apply vị trí FAB sau khi DOM có kích thước
    requestAnimationFrame(() => {
        applySavedPos(toggleBtn, settings.fabPos);
    });

    // ===== Drag helper =====
    function makeDraggable(el, handleEl, storageKey, { onDragStart, onDragEnd } = {}) {
        let dragging = false;
        let startX = 0, startY = 0;
        let startLeft = 0, startTop = 0;
        let moved = false;
        let pointerId = null;

        function onPointerDown(e) {
            if (e.button !== undefined && e.button !== 0) return;

            // Bỏ qua khi bấm vào button/input bên trong handle
            const t = e.target;
            if (t && t.closest && t.closest('button, input, a, textarea, select')) return;

            dragging = true;
            moved = false;
            pointerId = e.pointerId;
            startX = e.clientX;
            startY = e.clientY;

            const rect = el.getBoundingClientRect();
            startLeft = rect.left;
            startTop = rect.top;

            el.style.setProperty('left', rect.left + 'px', 'important');
            el.style.setProperty('top', rect.top + 'px', 'important');
            el.style.setProperty('right', 'auto', 'important');
            el.style.setProperty('bottom', 'auto', 'important');

            el.classList.add('dragging');

            try { handleEl.setPointerCapture(e.pointerId); } catch {}

            document.addEventListener('pointermove', onPointerMove, true);
            document.addEventListener('pointerup', onPointerUp, true);
            document.addEventListener('pointercancel', onPointerUp, true);

            onDragStart?.();
        }

        function onPointerMove(e) {
            if (!dragging) return;
            if (pointerId !== null && e.pointerId !== pointerId) return;

            const dx = e.clientX - startX;
            const dy = e.clientY - startY;

            if (!moved && (Math.abs(dx) > 3 || Math.abs(dy) > 3)) moved = true;
            if (!moved) return;

            const w = el.offsetWidth;
            const h = el.offsetHeight;
            let newLeft = startLeft + dx;
            let newTop = startTop + dy;

            newLeft = Math.max(0, Math.min(window.innerWidth - w, newLeft));
            newTop = Math.max(0, Math.min(window.innerHeight - h, newTop));

            el.style.setProperty('left', newLeft + 'px', 'important');
            el.style.setProperty('top', newTop + 'px', 'important');

            e.preventDefault();
        }

        function onPointerUp(e) {
            if (!dragging) return;
            if (pointerId !== null && e.pointerId !== pointerId) return;

            dragging = false;
            pointerId = null;
            document.removeEventListener('pointermove', onPointerMove, true);
            document.removeEventListener('pointerup', onPointerUp, true);
            document.removeEventListener('pointercancel', onPointerUp, true);

            try { handleEl.releasePointerCapture(e.pointerId); } catch {}

            el.classList.remove('dragging');

            if (moved) {
                const rect = el.getBoundingClientRect();
                settings[storageKey] = { x: rect.left, y: rect.top };
                saveSettings(settings);
            }

            onDragEnd?.(moved);
        }

        handleEl.addEventListener('pointerdown', onPointerDown);
    }

    // Wire FAB
    makeDraggable(toggleBtn, toggleBtn, 'fabPos', {
        onDragStart: () => {
            toggleBtn.style.setProperty('transition', 'none', 'important');
        },
        onDragEnd: (moved) => {
            toggleBtn.style.removeProperty('transition');
            if (moved) {
                toggleBtn.dataset.justDragged = '1';
                setTimeout(() => delete toggleBtn.dataset.justDragged, 80);
            }
        }
    });

    // Wire Panel (qua header)
    const panelHeader = panel.querySelector('#imgdl-header');
    makeDraggable(panel, panelHeader, 'panelPos', {
        onDragStart: () => {},
        onDragEnd: () => {}
    });

    // ===== Helpers =====
    function pickRealSrc(img) {
        const lazyAttrs = ['data-src', 'data-original', 'data-lazy-src'];
        for (const attr of lazyAttrs) {
            const v = img.getAttribute(attr);
            if (v && v.startsWith('http')) return v;
        }
        const srcset = img.getAttribute('srcset');
        if (srcset) {
            const last = srcset.split(',').pop().trim().split(/\s+/)[0];
            if (last && last.startsWith('http')) return last;
        }
        const src = img.currentSrc || img.src;
        if (src && src.startsWith('http')) return src;
        return null;
    }

    function getExt(url) {
        try {
            const path = new URL(url).pathname;
            const m = path.match(/\.([a-z0-9]{2,5})$/i);
            return m ? m[1].toLowerCase() : '';
        } catch { return ''; }
    }

    async function forceLoadImages() {
        const imgs = [...document.querySelectorAll('img')];
        for (const img of imgs) {
            const lazy = img.getAttribute('data-src')
                      || img.getAttribute('data-original')
                      || img.getAttribute('data-lazy-src');
            const currentSrc = img.currentSrc || img.src || '';
            if (lazy && lazy.startsWith('http') && (!currentSrc || currentSrc === 'about:blank')) {
                try { img.src = lazy; } catch {}
            }
            if (img.decode) { try { await img.decode(); } catch {} }
            else if (!img.complete) {
                await new Promise(r => {
                    img.addEventListener('load', r, { once: true });
                    img.addEventListener('error', r, { once: true });
                    setTimeout(r, 1500);
                });
            }
        }
    }

    function collectImages() {
        const set = new Set();
        const allowed = new Set(settings.formats.map(f => f.toLowerCase()));

        document.querySelectorAll('img').forEach(img => {
            const w = img.naturalWidth || 0;
            const h = img.naturalHeight || 0;
            if (w < MIN_SIZE || h < MIN_SIZE) return;

            const real = pickRealSrc(img);
            if (!real) return;

            let ext = getExt(real);
            if (ext === 'jpeg') ext = 'jpg';
            if (ext && !allowed.has(ext)) return;
            if (!ext && !allowed.has('jpg')) return;

            set.add(real);
        });
        return [...set];
    }

    function guessFilename(url, index) {
        try {
            const u = new URL(url);
            let name = decodeURIComponent(u.pathname.split('/').pop() || '');
            name = name.split('?')[0];
            if (!name || !/\.[a-z0-9]{2,5}$/i.test(name)) {
                name = `image_${index}.jpg`;
            }
            return name;
        } catch {
            return `image_${index}.jpg`;
        }
    }

    function render() {
        const list = panel.querySelector('#imgdl-list');
        const count = panel.querySelector('#imgdl-count');
        list.innerHTML = '';

        if (allImages.length === 0) {
            const empty = document.createElement('div');
            empty.id = 'imgdl-empty';
            empty.textContent = 'Không tìm thấy ảnh nào';
            list.appendChild(empty);
            count.textContent = '0';
            updateSelected();
            return;
        }

        count.textContent = allImages.length;
        allImages.forEach(url => {
            const item = document.createElement('div');
            item.className = 'imgdl-item' + (selected.has(url) ? ' selected' : '');
            item.title = url;
            item.dataset.url = url;

            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.onerror = () => { item.style.opacity = '.3'; };

            item.appendChild(img);
            item.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (selected.has(url)) selected.delete(url);
                else selected.add(url);
                item.classList.toggle('selected');
                updateSelected();
            }, true);

            list.appendChild(item);
        });
        updateSelected();
    }

    function updateSelected() {
        panel.querySelector('#imgdl-selected-count').textContent =
            `Đã chọn: ${selected.size}`;

        const badge = document.getElementById('imgdl-badge');
        if (!badge) return;
        if (selected.size > 0) {
            badge.textContent = selected.size > 99 ? '99+' : selected.size;
            badge.classList.add('show');
        } else {
            badge.classList.remove('show');
        }
    }

    function setProgress(text) {
        panel.querySelector('#imgdl-progress').textContent = text;
    }

    // ===== Referer resolution =====
    function getRefererForUrl(url) {
        try {
            const imgHost = new URL(url).hostname;
            for (const r of settings.extraReferers) {
                try {
                    const rHost = new URL(r).hostname;
                    if (imgHost === rHost || imgHost.endsWith('.' + rHost) || rHost.endsWith('.' + imgHost)) {
                        return r;
                    }
                } catch {}
            }
        } catch {}
        return location.origin + '/';
    }

    function fetchAsBlob(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'GET',
                url,
                responseType: 'blob',
                headers: {
                    'Referer': getRefererForUrl(url),
                    'Accept': 'image/avif,image/webp,image/apng,image/*,*/*;q=0.8',
                },
                onload: (res) => {
                    if (res.status >= 200 && res.status < 300 && res.response) {
                        resolve(res.response);
                    } else {
                        reject(new Error('HTTP ' + res.status));
                    }
                },
                onerror: () => reject(new Error('network')),
                ontimeout: () => reject(new Error('timeout')),
            });
        });
    }

    // ===== Download =====
    function triggerBlobDownload(blob, filename) {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 3000);
    }

    async function downloadBase(urls, onProgress) {
        let ok = 0, fail = 0, idx = 0;
        for (const url of urls) {
            idx++;
            onProgress(`Đang tải ${idx}/${urls.length}...`);
            try {
                const blob = await fetchAsBlob(url);
                triggerBlobDownload(blob, guessFilename(url, idx));
                ok++;
            } catch (e) {
                console.warn('[imgdl] Fail:', url, e);
                fail++;
            }
            await new Promise(r => setTimeout(r, settings.delayMs));
        }
        return { ok, fail };
    }

    async function downloadZip(urls, onProgress) {
        onProgress('Đang load JSZip...');
        const JSZip = await loadJSZip();
        const zip = new JSZip();

        let ok = 0, fail = 0, idx = 0;
        const usedNames = new Set();

        for (const url of urls) {
            idx++;
            onProgress(`Đang tải ${idx}/${urls.length}...`);
            try {
                const blob = await fetchAsBlob(url);
                let name = guessFilename(url, idx);
                if (usedNames.has(name)) {
                    const dot = name.lastIndexOf('.');
                    const base = dot > 0 ? name.slice(0, dot) : name;
                    const ext = dot > 0 ? name.slice(dot) : '';
                    let n = 1;
                    while (usedNames.has(`${base}_${n}${ext}`)) n++;
                    name = `${base}_${n}${ext}`;
                }
                usedNames.add(name);
                zip.file(name, blob);
                ok++;
            } catch (e) {
                console.warn('[imgdl] Fail:', url, e);
                fail++;
            }
            await new Promise(r => setTimeout(r, settings.delayMs));
        }

        onProgress('Đang nén ZIP...');
        const zipBlob = await zip.generateAsync({ type: 'blob' });
        triggerBlobDownload(zipBlob, `images_${Date.now()}.zip`);
        return { ok, fail };
    }

    async function downloadSelected() {
        if (selected.size === 0) {
            alert('Chưa chọn ảnh nào');
            return;
        }
        const btn = panel.querySelector('#imgdl-download');
        btn.disabled = true;

        try {
            const urls = [...selected];
            let result;
            if (settings.downloadMode === 'zip') {
                result = await downloadZip(urls, setProgress);
            } else {
                result = await downloadBase(urls, setProgress);
            }
            setProgress(`Xong: ${result.ok} ok, ${result.fail} lỗi`);
        } catch (e) {
            console.error(e);
            setProgress('Lỗi: ' + e.message);
        } finally {
            btn.disabled = false;
            setTimeout(() => setProgress(''), 4000);
        }
    }

    // ===== Settings UI =====
    const ALL_FORMATS = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif', 'svg', 'bmp', 'ico'];

    function renderSettingsUI() {
        panel.querySelectorAll('#imgdl-mode button').forEach(b => {
            b.classList.toggle('active', b.dataset.mode === settings.downloadMode);
        });

        const delayEl = panel.querySelector('#imgdl-delay');
        delayEl.value = settings.delayMs;
        panel.querySelector('#imgdl-delay-val').textContent = settings.delayMs + 'ms';

        const fmtWrap = panel.querySelector('#imgdl-formats');
        fmtWrap.innerHTML = '';
        ALL_FORMATS.forEach(f => {
            const label = document.createElement('label');
            label.className = 'imgdl-fmt' + (settings.formats.includes(f) ? ' on' : '');
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.checked = settings.formats.includes(f);
            cb.addEventListener('change', () => {
                if (cb.checked) {
                    if (!settings.formats.includes(f)) settings.formats.push(f);
                } else {
                    settings.formats = settings.formats.filter(x => x !== f);
                }
                label.classList.toggle('on', cb.checked);
                saveSettings(settings);
            });
            label.appendChild(cb);
            label.appendChild(document.createTextNode('.' + f));
            fmtWrap.appendChild(label);
        });

        renderRefererList();
    }

    function renderRefererList() {
        const wrap = panel.querySelector('#imgdl-referer-list');
        wrap.innerHTML = '';
        if (settings.extraReferers.length === 0) {
            const hint = document.createElement('div');
            hint.className = 'imgdl-hint';
            hint.textContent = 'Chưa có referer tùy chỉnh.';
            wrap.appendChild(hint);
            return;
        }
        settings.extraReferers.forEach((r, i) => {
            const row = document.createElement('div');
            row.className = 'imgdl-referer-row';
            const span = document.createElement('span');
            span.textContent = r;
            const btn = document.createElement('button');
            btn.textContent = '✕';
            btn.title = 'Xoá';
            btn.addEventListener('click', () => {
                settings.extraReferers.splice(i, 1);
                saveSettings(settings);
                renderRefererList();
            });
            row.appendChild(span);
            row.appendChild(btn);
            wrap.appendChild(row);
        });
    }

    // ===== Events =====
    toggleBtn.addEventListener('click', (e) => {
        if (toggleBtn.dataset.justDragged) return;
        e.preventDefault();
        e.stopPropagation();
        const isOpen = panel.classList.toggle('open');
        toggleBtn.classList.toggle('open', isOpen);
        if (isOpen) {
            requestAnimationFrame(() => {
                applySavedPos(panel, settings.panelPos);
            });
            if (allImages.length === 0) scan();
        }
    }, true);

    // Tabs
    panel.querySelectorAll('.imgdl-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const name = tab.dataset.tab;
            panel.querySelectorAll('.imgdl-tab').forEach(t => t.classList.toggle('active', t === tab));
            panel.querySelectorAll('.imgdl-page').forEach(p => {
                p.classList.toggle('active', p.dataset.page === name);
            });
        });
    });

    // Mode toggle
    panel.querySelectorAll('#imgdl-mode button').forEach(b => {
        b.addEventListener('click', () => {
            settings.downloadMode = b.dataset.mode;
            saveSettings(settings);
            renderSettingsUI();
        });
    });

    // Delay slider
    const delayEl = panel.querySelector('#imgdl-delay');
    delayEl.addEventListener('input', () => {
        settings.delayMs = parseInt(delayEl.value, 10);
        panel.querySelector('#imgdl-delay-val').textContent = settings.delayMs + 'ms';
        saveSettings(settings);
    });

    // Referer add
    const refInput = panel.querySelector('#imgdl-referer-input');
    const refAddBtn = panel.querySelector('#imgdl-referer-add');
    function addReferer() {
        let v = refInput.value.trim();
        if (!v) return;
        if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
        if (!v.endsWith('/')) v += '/';
        try { new URL(v); } catch { alert('URL không hợp lệ'); return; }
        if (!settings.extraReferers.includes(v)) {
            settings.extraReferers.push(v);
            saveSettings(settings);
            renderRefererList();
        }
        refInput.value = '';
    }
    refAddBtn.addEventListener('click', addReferer);
    refInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') addReferer(); });

    // Reset position
    panel.querySelector('#imgdl-reset-pos').addEventListener('click', () => {
        settings.fabPos = null;
        settings.panelPos = null;
        saveSettings(settings);

        // Reset FAB
        toggleBtn.style.removeProperty('left');
        toggleBtn.style.removeProperty('top');
        toggleBtn.style.setProperty('right', '24px', 'important');
        toggleBtn.style.setProperty('bottom', '24px', 'important');

        // Reset panel
        panel.style.removeProperty('left');
        panel.style.removeProperty('top');
        panel.style.setProperty('right', '24px', 'important');
        panel.style.setProperty('bottom', '92px', 'important');
    });

    // ===== Multi-select menu =====
    const multiBtn = panel.querySelector('#imgdl-multi');
    const multiMenu = panel.querySelector('#imgdl-multi-menu');
    multiMenu.innerHTML = `
        <button data-action="all">Chọn tất cả</button>
        <button data-action="invert">Chọn đối nghịch</button>
        <button data-action="none">Bỏ chọn tất cả</button>
    `;

    multiBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        multiMenu.classList.toggle('open');
    }, true);

    document.addEventListener('click', (e) => {
        if (!multiMenu.classList.contains('open')) return;
        if (multiMenu.contains(e.target) || multiBtn.contains(e.target)) return;
        multiMenu.classList.remove('open');
    }, true);

    multiMenu.querySelectorAll('button').forEach(b => {
        b.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const action = b.dataset.action;

            if (action === 'all') {
                allImages.forEach(u => selected.add(u));
            } else if (action === 'none') {
                selected.clear();
            } else if (action === 'invert') {
                allImages.forEach(u => {
                    if (selected.has(u)) selected.delete(u);
                    else selected.add(u);
                });
            }

            panel.querySelectorAll('.imgdl-item').forEach(item => {
                const url = item.dataset.url;
                item.classList.toggle('selected', selected.has(url));
            });
            updateSelected();
            multiMenu.classList.remove('open');
        }, true);
    });

    // Rescan
    panel.querySelector('#imgdl-rescan').addEventListener('click', scan);
    // Download
    panel.querySelector('#imgdl-download').addEventListener('click', downloadSelected);

    async function scan() {
        setProgress('Đang quét...');
        await forceLoadImages();
        allImages = collectImages();
        selected.clear();
        allImages.forEach(u => selected.add(u));
        setProgress('');
        render();
    }

    // ===== Window resize handler =====
    window.addEventListener('resize', () => {
        if (settings.fabPos) {
            const rect = toggleBtn.getBoundingClientRect();
            const x = Math.max(0, Math.min(window.innerWidth - rect.width, rect.left));
            const y = Math.max(0, Math.min(window.innerHeight - rect.height, rect.top));
            toggleBtn.style.setProperty('left', x + 'px', 'important');
            toggleBtn.style.setProperty('top', y + 'px', 'important');
            settings.fabPos = { x, y };
            saveSettings(settings);
        }
        if (settings.panelPos && panel.classList.contains('open')) {
            const rect = panel.getBoundingClientRect();
            const x = Math.max(0, Math.min(window.innerWidth - rect.width, rect.left));
            const y = Math.max(0, Math.min(window.innerHeight - rect.height, rect.top));
            panel.style.setProperty('left', x + 'px', 'important');
            panel.style.setProperty('top', y + 'px', 'important');
            settings.panelPos = { x, y };
            saveSettings(settings);
        }
    });

    // ===== Init =====
    renderSettingsUI();
})();

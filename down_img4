            display: flex !important; gap: 8px !important; align-items: center !important;
            justify-content: space-between !important; box-sizing: border-box !important;
        }
        #imgdl-footer .imgdl-meta {
            display: flex !important; flex-direction: column !important;
            font-size: 11px !important; color: #555 !important;
        }
        #imgdl-footer button#imgdl-download {
            all: unset; padding: 7px 14px !important; border-radius: 6px !important;
            background: #2ecc71 !important; color: #fff !important;
            cursor: pointer !important; font-size: 13px !important;
            font-weight: 600 !important; box-sizing: border-box !important;

// ==UserScript==
// @name         Image Downloader MVP
// @namespace    http://tampermonkey.net/
// @version      2.0
// @description  Quét ảnh, chọn, tải về / tải ZIP, có trang settings
// @match        *://*/*
// @grant        GM_download
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      *
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // ===== Settings mặc định =====
    const DEFAULT_SETTINGS = {
        downloadMode: 'base',       // 'base' | 'zip'
        delayMs: 250,               // delay giữa các ảnh
        formats: ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif', 'svg', 'bmp', 'ico'],
        extraReferers: [],          // mảng domain referer tuỳ chỉnh
    };

    function loadSettings() {
        try {
            const raw = GM_getValue('imgdl_settings', null);
            if (!raw) return { ...DEFAULT_SETTINGS };
            const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;
            return { ...DEFAULT_SETTINGS, ...parsed };
        } catch {
            return { ...DEFAULT_SETTINGS };
        }
    }
    function saveSettings(s) {
        GM_setValue('imgdl_settings', JSON.stringify(s));
    }

    let settings = loadSettings();

    // ===== Load JSZip lazily (chỉ khi cần) =====
    const JSZIP_URL = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
    let jszipPromise = null;
    function loadJSZip() {
        if (jszipPromise) return jszipPromise;
        jszipPromise = new Promise((resolve, reject) => {
            if (window.JSZip) return resolve(window.JSZip);
            const s = document.createElement('script');
            s.src = JSZIP_URL;
            s.onload = () => resolve(window.JSZip);
            s.onerror = () => reject(new Error('Không load được JSZip'));
            document.head.appendChild(s);
        });
        return jszipPromise;
    }

    const MIN_SIZE = 100;


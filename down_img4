// ==UserScript==
// @name         Image Downloader MVP
// @namespace    http://tampermonkey.net/
// @version      1.4
// @description  Quét ảnh trên trang, chọn/bỏ chọn, tải về (bypass hotlink)
// @match        *://*/*
// @grant        GM_download
// @grant        GM_xmlhttpRequest
// @connect      *
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const MIN_SIZE = 100;

    // ===== CSS (giữ nguyên) =====
    const style = document.createElement('style');
    style.textContent = `
        #imgdl-toggle {
            all: unset;
            position: fixed !important; bottom: 20px !important; right: 20px !important;
            z-index: 2147483647 !important; width: 48px !important; height: 48px !important;
            border-radius: 50% !important; background: #222 !important; color: #fff !important;
            font-size: 22px !important; line-height: 48px !important; text-align: center !important;
            cursor: pointer !important; box-shadow: 0 4px 12px rgba(0,0,0,.3) !important;
            box-sizing: border-box !important;
        }
        #imgdl-panel {
            all: unset;
            position: fixed !important; bottom: 80px !important; right: 20px !important;
            z-index: 2147483647 !important; width: 360px !important; max-height: 72vh !important;
            background: #fff !important; color: #222 !important; border-radius: 10px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
            font-family: system-ui, -apple-system, sans-serif !important;
            font-size: 13px !important; display: none !important; flex-direction: column !important;
            overflow: hidden !important; box-sizing: border-box !important; line-height: 1.3 !important;
        }
        #imgdl-panel.open { display: flex !important; }
        #imgdl-header {
            padding: 10px 12px !important; background: #222 !important; color: #fff !important;
            display: flex !important; justify-content: space-between !important;
            align-items: center !important; font-weight: 600 !important;
        }
        #imgdl-header button {
            all: unset; background: transparent !important; color: #fff !important;
            border: 1px solid #666 !important; border-radius: 4px !important;
            cursor: pointer !important; font-size: 11px !important;
            padding: 3px 8px !important; box-sizing: border-box !important;
        }
        #imgdl-list {
            flex: 1 1 auto !important; overflow-y: auto !important; padding: 8px !important;
            display: grid !important; grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            gap: 6px !important; box-sizing: border-box !important;
        }
        .imgdl-item {
            all: unset; position: relative !important; display: block !important;
            width: 100% !important; padding-top: 100% !important; border-radius: 6px !important;
            overflow: hidden !important; cursor: pointer !important; background: #eee !important;
            border: 2px solid transparent !important; box-sizing: border-box !important;
            user-select: none !important;
        }
        .imgdl-item > img {
            all: unset; position: absolute !important; top: 0 !important; left: 0 !important;
            width: 100% !important; height: 100% !important; object-fit: cover !important;
            display: block !important; pointer-events: none !important;
        }
        .imgdl-item.selected { border-color: #2ecc71 !important; }
        .imgdl-item.selected::after {
            content: "✓" !important; position: absolute !important; top: 2px !important;
            right: 6px !important; color: #2ecc71 !important; font-weight: bold !important;
            font-size: 16px !important; text-shadow: 0 0 3px #fff, 0 0 3px #fff !important;
            pointer-events: none !important;
        }
        #imgdl-footer {
            padding: 10px 12px !important; border-top: 1px solid #eee !important;
            display: flex !important; gap: 8px !important; align-items: center !important;
            justify-content: space-between !important; box-sizing: border-box !important;
        }
        #imgdl-footer button {
            all: unset; padding: 6px 12px !important; border-radius: 6px !important;
            border: 1px solid #ccc !important; background: #f5f5f5 !important;
            color: #222 !important; cursor: pointer !important; font-size: 13px !important;
            box-sizing: border-box !important;
        }
        #imgdl-download {
            background: #2ecc71 !important; color: #fff !important;
            border-color: #2ecc71 !important;
        }
        #imgdl-download:disabled { opacity: .5 !important; cursor: not-allowed !important; }
        #imgdl-empty {
            grid-column: 1 / -1 !important; padding: 20px !important;
            text-align: center !important; color: #888 !important;
        }
        #imgdl-progress { font-size: 12px !important; color: #555 !important; }
    `;
    document.head.appendChild(style);

    // ===== DOM =====
    const toggleBtn = document.createElement('button');
    toggleBtn.id = 'imgdl-toggle';
    toggleBtn.textContent = '🖼';

    const panel = document.createElement('div');
    panel.id = 'imgdl-panel';
    panel.innerHTML = `
        <div id="imgdl-header">
            <span>Ảnh (<span id="imgdl-count">0</span>)</span>
            <button id="imgdl-rescan">Quét lại</button>
        </div>
        <div id="imgdl-list"></div>
        <div id="imgdl-footer">
            <span id="imgdl-selected-count">Đã chọn: 0</span>
            <span id="imgdl-progress"></span>
            <button id="imgdl-download">Tải về</button>
        </div>
    `;

    document.body.appendChild(toggleBtn);
    document.body.appendChild(panel);

    const selected = new Set();
    let allImages = [];

    // ===== Helpers =====
    function pickRealSrc(img) {
        const lazyAttrs = ['data-src', 'data-original', 'data-lazy-src'];
        for (const attr of lazyAttrs) {
            const v = img.getAttribute(attr);
            if (v && v.startsWith('http')) return v;
        }
        const srcset = img.getAttribute('srcset');
        if (srcset) {
            const last = srcset.split(',').pop().trim().split(/\s+/)[0];
            if (last && last.startsWith('http')) return last;
        }
        const src = img.currentSrc || img.src;
        if (src && src.startsWith('http')) return src;
        return null;
    }

    async function forceLoadImages() {
        const imgs = [...document.querySelectorAll('img')];
        for (const img of imgs) {
            const lazy = img.getAttribute('data-src')
                      || img.getAttribute('data-original')
                      || img.getAttribute('data-lazy-src');
            const currentSrc = img.currentSrc || img.src || '';
            if (lazy && lazy.startsWith('http') && (!currentSrc || currentSrc === 'about:blank')) {
                try { img.src = lazy; } catch {}
            }
            if (img.decode) { try { await img.decode(); } catch {} }
            else if (!img.complete) {
                await new Promise(r => {
                    img.addEventListener('load', r, { once: true });
                    img.addEventListener('error', r, { once: true });
                    setTimeout(r, 1500);
                });
            }
        }
    }

    function collectImages() {
        const set = new Set();
        document.querySelectorAll('img').forEach(img => {
            const w = img.naturalWidth || 0;
            const h = img.naturalHeight || 0;
            if (w < MIN_SIZE || h < MIN_SIZE) return;
            const real = pickRealSrc(img);
            if (real) set.add(real);
        });
        return [...set];
    }

    function guessFilename(url, index) {
        try {
            const u = new URL(url);
            let name = decodeURIComponent(u.pathname.split('/').pop() || '');
            name = name.split('?')[0];
            if (!name || !/\.[a-z0-9]{2,5}$/i.test(name)) {
                name = `image_${index}.jpg`;
            }
            return name;
        } catch {
            return `image_${index}.jpg`;
        }
    }

    function render() {
        const list = panel.querySelector('#imgdl-list');
        const count = panel.querySelector('#imgdl-count');
        list.innerHTML = '';

        if (allImages.length === 0) {
            const empty = document.createElement('div');
            empty.id = 'imgdl-empty';
            empty.textContent = 'Không tìm thấy ảnh nào';
            list.appendChild(empty);
            count.textContent = '0';
            updateSelected();
            return;
        }

        count.textContent = allImages.length;
        allImages.forEach(url => {
            const item = document.createElement('div');
            item.className = 'imgdl-item' + (selected.has(url) ? ' selected' : '');
            item.title = url;

            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.onerror = () => { item.style.opacity = '.3'; };

            item.appendChild(img);
            item.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (selected.has(url)) selected.delete(url);
                else selected.add(url);
                item.classList.toggle('selected');
                updateSelected();
            }, true);

            list.appendChild(item);
        });
        updateSelected();
    }

    function updateSelected() {
        panel.querySelector('#imgdl-selected-count').textContent =
            `Đã chọn: ${selected.size}`;
    }

    function setProgress(text) {
        panel.querySelector('#imgdl-progress').textContent = text;
    }

    // ===== Tải qua GM_xmlhttpRequest với Referer =====
    function fetchAsBlob(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'GET',
                url,
                responseType: 'blob',
                headers: {
                    // Referer = origin của trang hiện tại → bypass hotlink check
                    'Referer': location.origin + '/',
                    'Accept': 'image/avif,image/webp,image/apng,image/*,*/*;q=0.8',
                },
                onload: (res) => {
                    if (res.status >= 200 && res.status < 300 && res.response) {
                        resolve(res.response);
                    } else {
                        reject(new Error('HTTP ' + res.status));
                    }
                },
                onerror: reject,
                ontimeout: () => reject(new Error('timeout')),
            });
        });
    }

    async function downloadSelected() {
        if (selected.size === 0) {
            alert('Chưa chọn ảnh nào');
            return;
        }
        const btn = panel.querySelector('#imgdl-download');
        btn.disabled = true;

        const urls = [...selected];
        let idx = 0, ok = 0, fail = 0;
        for (const url of urls) {
            idx++;
            const filename = guessFilename(url, idx);
            setProgress(`${idx}/${urls.length}...`);
            try {
                const blob = await fetchAsBlob(url);

                // Nếu server trả ảnh lỗi 4.44KB thì vẫn tải — nhưng log để biết
                if (blob.size < 3000) {
                    console.warn('[imgdl] Nghi ngờ ảnh lỗi/placeholder:', blob.size, url);
                }

                const a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(a.href), 3000);
                ok++;
            } catch (e) {
                console.warn('[imgdl] Fail:', url, e);
                fail++;
            }
            await new Promise(r => setTimeout(r, 250));
        }

        setProgress(`Xong: ${ok} ok, ${fail} lỗi`);
        btn.disabled = false;
        setTimeout(() => setProgress(''), 3000);
    }

    // ===== Events =====
    toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        panel.classList.toggle('open');
        if (panel.classList.contains('open') && allImages.length === 0) scan();
    }, true);

    panel.querySelector('#imgdl-rescan').addEventListener('click', scan);
    panel.querySelector('#imgdl-download').addEventListener('click', downloadSelected);

    async function scan() {
        setProgress('Đang quét...');
        await forceLoadImages();
        allImages = collectImages();
        selected.clear();
        allImages.forEach(u => selected.add(u));
        setProgress('');
        render();
    }
})();

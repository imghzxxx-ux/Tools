    document.head.appendChild(style);

    // ===== DOM =====
    const toggleBtn = document.createElement('button');
    toggleBtn.id = 'imgdl-toggle';
    toggleBtn.textContent = '🖼';

    const panel = document.createElement('div');
    panel.id = 'imgdl-panel';
    panel.innerHTML = `
        <div id="imgdl-header">
            <span>Image Downloader</span>
            <button id="imgdl-rescan">Quét lại</button>
        </div>
        <div id="imgdl-tabs">
            <button class="imgdl-tab active" data-tab="images">Ảnh (<span id="imgdl-count">0</span>)</button>
            <button class="imgdl-tab" data-tab="settings">Cài đặt</button>
        </div>

        <div class="imgdl-page active" data-page="images">
            <div id="imgdl-list"></div>
        </div>

        <div class="imgdl-page" data-page="settings">
            <div id="imgdl-settings">
                <div class="imgdl-field">
                    <label>Chế độ tải</label>
                    <div class="imgdl-toggle-group" id="imgdl-mode">
                        <button data-mode="base">Tải từng ảnh</button>
                        <button data-mode="zip">Đóng ZIP</button>
                    </div>
                </div>

                <div class="imgdl-field">
                    <label>Tốc độ tải (delay giữa các ảnh)</label>
                    <div class="imgdl-slider-row">
                        <input type="range" id="imgdl-delay" min="0" max="2000" step="50" value="250">
                        <span class="imgdl-slider-val" id="imgdl-delay-val">250ms</span>
                    </div>
                    <div class="imgdl-hint">Càng nhỏ càng nhanh, nhưng dễ bị server chặn.</div>
                </div>

                <div class="imgdl-field">
                    <label>Định dạng ưu tiên</label>
                    <div class="imgdl-formats" id="imgdl-formats"></div>
                    <div class="imgdl-hint">Chỉ quét các định dạng được chọn.</div>
                </div>

                <div class="imgdl-field">
                    <label>Referer tùy chỉnh</label>
                    <div class="imgdl-referer-list" id="imgdl-referer-list"></div>
                    <div class="imgdl-add-row">
                        <input type="text" id="imgdl-referer-input" placeholder="https://example.com/">
                        <button id="imgdl-referer-add">Thêm</button>
                    </div>
                    <div class="imgdl-hint">Referer mặc định là origin trang hiện tại. Thêm vào để thử các domain khác nếu bị 403.</div>
                </div>
            </div>
        </div>

        <div id="imgdl-footer">
            <div class="imgdl-meta">
                <span id="imgdl-selected-count">Đã chọn: 0</span>
                <span id="imgdl-progress"></span>
            </div>
            <button id="imgdl-download">Tải về</button>
        </div>
    `;

    document.body.appendChild(toggleBtn);
    document.body.appendChild(panel);

    const selected = new Set();
    let allImages = [];

    // ===== Helpers =====
    function pickRealSrc(img) {
        const lazyAttrs = ['data-src', 'data-original', 'data-lazy-src'];
        for (const attr of lazyAttrs) {
            const v = img.getAttribute(attr);
            if (v && v.startsWith('http')) return v;
        }
        const srcset = img.getAttribute('srcset');
        if (srcset) {
            const last = srcset.split(',').pop().trim().split(/\s+/)[0];
            if (last && last.startsWith('http')) return last;
        }
        const src = img.currentSrc || img.src;
        if (src && src.startsWith('http')) return src;
        return null;
    }

    function getExt(url) {
        try {
            const path = new URL(url).pathname;
            const m = path.match(/\.([a-z0-9]{2,5})$/i);
            return m ? m[1].toLowerCase() : '';
        } catch { return ''; }
    }

    async function forceLoadImages() {
        const imgs = [...document.querySelectorAll('img')];
        for (const img of imgs) {
            const lazy = img.getAttribute('data-src')
                      || img.getAttribute('data-original')
                      || img.getAttribute('data-lazy-src');
            const currentSrc = img.currentSrc || img.src || '';
            if (lazy && lazy.startsWith('http') && (!currentSrc || currentSrc === 'about:blank')) {
                try { img.src = lazy; } catch {}
            }
            if (img.decode) { try { await img.decode(); } catch {} }
            else if (!img.complete) {
                await new Promise(r => {
                    img.addEventListener('load', r, { once: true });
                    img.addEventListener('error', r, { once: true });
                    setTimeout(r, 1500);
                });
            }
        }
    }

    function collectImages() {
        const set = new Set();
        const allowed = new Set(settings.formats.map(f => f.toLowerCase()));

        document.querySelectorAll('img').forEach(img => {
            const w = img.naturalWidth || 0;
            const h = img.naturalHeight || 0;
            if (w < MIN_SIZE || h < MIN_SIZE) return;

            const real = pickRealSrc(img);
            if (!real) return;

            // Filter theo định dạng
            let ext = getExt(real);
            if (ext === 'jpeg') ext = 'jpg';
            if (ext && !allowed.has(ext)) return;
            // Nếu URL không có đuôi → coi như jpg (fallback chung)
            if (!ext && !allowed.has('jpg')) return;

            set.add(real);
        });
        return [...set];
    }

    function guessFilename(url, index) {
        try {
            const u = new URL(url);
            let name = decodeURIComponent(u.pathname.split('/').pop() || '');
            name = name.split('?')[0];
            if (!name || !/\.[a-z0-9]{2,5}$/i.test(name)) {
                name = `image_${index}.jpg`;
            }
            return name;
        } catch {
            return `image_${index}.jpg`;
        }
    }

    function render() {
        const list = panel.querySelector('#imgdl-list');
        const count = panel.querySelector('#imgdl-count');
        list.innerHTML = '';

        if (allImages.length === 0) {
            const empty = document.createElement('div');
            empty.id = 'imgdl-empty';
            empty.textContent = 'Không tìm thấy ảnh nào';
            list.appendChild(empty);
            count.textContent = '0';
            updateSelected();
            return;
        }

        count.textContent = allImages.length;
        allImages.forEach(url => {
            const item = document.createElement('div');
            item.className = 'imgdl-item' + (selected.has(url) ? ' selected' : '');
            item.title = url;

            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.onerror = () => { item.style.opacity = '.3'; };

            item.appendChild(img);
            item.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (selected.has(url)) selected.delete(url);
                else selected.add(url);
                item.classList.toggle('selected');
                updateSelected();
            }, true);

            list.appendChild(item);
        });
        updateSelected();
    }

    function updateSelected() {
        panel.querySelector('#imgdl-selected-count').textContent =
            `Đã chọn: ${selected.size}`;
    }

    function setProgress(text) {
        panel.querySelector('#imgdl-progress').textContent = text;
    }

    // ===== Referer resolution =====
    function getRefererForUrl(url) {
        // 1. Nếu user có list, thử match theo domain ảnh
        try {
            const imgHost = new URL(url).hostname;
            for (const r of settings.extraReferers) {
                try {
                    const rHost = new URL(r).hostname;
                    if (imgHost === rHost || imgHost.endsWith('.' + rHost) || rHost.endsWith('.' + imgHost)) {
                        return r;
                    }
                } catch {}
            }
        } catch {}
        // 2. Mặc định: origin của trang hiện tại
        return location.origin + '/';
    }

    function fetchAsBlob(url) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method: 'GET',
                url,
                responseType: 'blob',
                headers: {
                    'Referer': getRefererForUrl(url),
                    'Accept': 'image/avif,image/webp,image/apng,image/*,*/*;q=0.8',
                },
                onload: (res) => {
                    if (res.status >= 200 && res.status < 300 && res.response) {
                        resolve(res.response);
                    } else {
                        reject(new Error('HTTP ' + res.status));
                    }
                },
                onerror: () => reject(new Error('network')),
                ontimeout: () => reject(new Error('timeout')),
            });
        });
    }

    // ===== Download =====
    function triggerBlobDownload(blob, filename) {
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 3000);
    }

    async function downloadBase(urls, onProgress) {
        let ok = 0, fail = 0, idx = 0;
        for (const url of urls) {
            idx++;
            onProgress(`Đang tải ${idx}/${urls.length}...`);
            try {
                const blob = await fetchAsBlob(url);
                triggerBlobDownload(blob, guessFilename(url, idx));
                ok++;
            } catch (e) {
                console.warn('[imgdl] Fail:', url, e);
                fail++;
            }
            await new Promise(r => setTimeout(r, settings.delayMs));
        }
        return { ok, fail };
    }

    async function downloadZip(urls, onProgress) {
        onProgress('Đang load JSZip...');
        const JSZip = await loadJSZip();
        const zip = new JSZip();

        let ok = 0, fail = 0, idx = 0;
        for (const url of urls) {
            idx++;
            onProgress(`Đang tải ${idx}/${urls.length}...`);
            try {
                const blob = await fetchAsBlob(url);
                const name = guessFilename(url, idx);
                zip.file(name, blob);
                ok++;
            } catch (e) {
                console.warn('[imgdl] Fail:', url, e);
                fail++;
            }
            await new Promise(r => setTimeout(r, settings.delayMs));
        }

        onProgress('Đang nén ZIP...');
        const zipBlob = await zip.generateAsync({ type: 'blob' });
        triggerBlobDownload(zipBlob, `images_${Date.now()}.zip`);
        return { ok, fail };
    }

    async function downloadSelected() {
        if (selected.size === 0) {
            alert('Chưa chọn ảnh nào');
            return;
        }
        const btn = panel.querySelector('#imgdl-download');
        btn.disabled = true;

        try {
            const urls = [...selected];
            let result;
            if (settings.downloadMode === 'zip') {
                result = await downloadZip(urls, setProgress);
            } else {
                result = await downloadBase(urls, setProgress);
            }
            setProgress(`Xong: ${result.ok} ok, ${result.fail} lỗi`);
        } catch (e) {
            console.error(e);
            setProgress('Lỗi: ' + e.message);
        } finally {
            btn.disabled = false;
            setTimeout(() => setProgress(''), 4000);
        }
    }

    // ===== Settings UI =====
    const ALL_FORMATS = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif', 'svg', 'bmp', 'ico'];

    function renderSettingsUI() {
        // Mode toggle
        panel.querySelectorAll('#imgdl-mode button').forEach(b => {
            b.classList.toggle('active', b.dataset.mode === settings.downloadMode);
        });

        // Delay slider
        const delayEl = panel.querySelector('#imgdl-delay');
        delayEl.value = settings.delayMs;
        panel.querySelector('#imgdl-delay-val').textContent = settings.delayMs + 'ms';

        // Formats
        const fmtWrap = panel.querySelector('#imgdl-formats');
        fmtWrap.innerHTML = '';
        ALL_FORMATS.forEach(f => {
            const label = document.createElement('label');
            label.className = 'imgdl-fmt' + (settings.formats.includes(f) ? ' on' : '');
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.checked = settings.formats.includes(f);
            cb.addEventListener('change', () => {
                if (cb.checked) {
                    if (!settings.formats.includes(f)) settings.formats.push(f);
                } else {
                    settings.formats = settings.formats.filter(x => x !== f);
                }
                label.classList.toggle('on', cb.checked);
                saveSettings(settings);
            });
            label.appendChild(cb);
            label.appendChild(document.createTextNode('.' + f));
            fmtWrap.appendChild(label);
        });

        // Referer list
        renderRefererList();
    }

    function renderRefererList() {
        const wrap = panel.querySelector('#imgdl-referer-list');
        wrap.innerHTML = '';
        if (settings.extraReferers.length === 0) {
            const hint = document.createElement('div');
            hint.className = 'imgdl-hint';
            hint.textContent = 'Chưa có referer tùy chỉnh.';
            wrap.appendChild(hint);
            return;
        }
        settings.extraReferers.forEach((r, i) => {
            const row = document.createElement('div');
            row.className = 'imgdl-referer-row';
            const span = document.createElement('span');
            span.textContent = r;
            const btn = document.createElement('button');
            btn.textContent = '✕';
            btn.title = 'Xoá';
            btn.addEventListener('click', () => {
                settings.extraReferers.splice(i, 1);
                saveSettings(settings);
                renderRefererList();
            });
            row.appendChild(span);
            row.appendChild(btn);
            wrap.appendChild(row);
        });
    }

    // ===== Events =====
    // Toggle panel
    toggleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        panel.classList.toggle('open');
        if (panel.classList.contains('open') && allImages.length === 0) scan();
    }, true);

    // Tabs
    panel.querySelectorAll('.imgdl-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            const name = tab.dataset.tab;
            panel.querySelectorAll('.imgdl-tab').forEach(t => t.classList.toggle('active', t === tab));
            panel.querySelectorAll('.imgdl-page').forEach(p => {
                p.classList.toggle('active', p.dataset.page === name);
            });
        });
    });

    // Mode toggle
    panel.querySelectorAll('#imgdl-mode button').forEach(b => {
        b.addEventListener('click', () => {
            settings.downloadMode = b.dataset.mode;
            saveSettings(settings);
            renderSettingsUI();
        });
    });

    // Delay slider
    const delayEl = panel.querySelector('#imgdl-delay');
    delayEl.addEventListener('input', () => {
        settings.delayMs = parseInt(delayEl.value, 10);
        panel.querySelector('#imgdl-delay-val').textContent = settings.delayMs + 'ms';
        saveSettings(settings);
    });

    // Referer add
    const refInput = panel.querySelector('#imgdl-referer-input');
    const refAddBtn = panel.querySelector('#imgdl-referer-add');
    function addReferer() {
        let v = refInput.value.trim();
        if (!v) return;
        if (!/^https?:\/\//i.test(v)) v = 'https://' + v;
        if (!v.endsWith('/')) v += '/';
        try { new URL(v); } catch { alert('URL không hợp lệ'); return; }
        if (!settings.extraReferers.includes(v)) {
            settings.extraReferers.push(v);
            saveSettings(settings);
            renderRefererList();
        }
        refInput.value = '';
    }
    refAddBtn.addEventListener('click', addReferer);
    refInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') addReferer(); });

    // Rescan
    panel.querySelector('#imgdl-rescan').addEventListener('click', scan);
    // Download
    panel.querySelector('#imgdl-download').addEventListener('click', downloadSelected);

    async function scan() {
        setProgress('Đang quét...');
        await forceLoadImages();
        allImages = collectImages();
        selected.clear();
        allImages.forEach(u => selected.add(u));
        setProgress('');
        render();
    }

    // ===== Init =====
    renderSettingsUI();
})();

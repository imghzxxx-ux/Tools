// ==UserScript==
// @name         Image Downloader MVP
// @namespace    http://tampermonkey.net/
// @version      1.1
// @description  Quét ảnh trên trang và tải về
// @match        *://*/*
// @grant        GM_download
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const PREFIX = 'imgdl';
    const uid = (n) => `${PREFIX}-${n}`;

    // ===== CSS (dùng !important + all:initial để chống CSS trang) =====
    const style = document.createElement('style');
    style.textContent = `
        #${uid('toggle')}, #${uid('panel')}, #${uid('panel')} * {
            box-sizing: border-box !important;
            font-family: system-ui, -apple-system, sans-serif !important;
            line-height: 1.4 !important;
        }
        #${uid('toggle')} {
            all: initial;
            position: fixed !important;
            bottom: 20px !important;
            right: 20px !important;
            z-index: 2147483647 !important;
            width: 48px !important;
            height: 48px !important;
            border-radius: 50% !important;
            background: #222 !important;
            color: #fff !important;
            border: none !important;
            font-size: 22px !important;
            cursor: pointer !important;
            box-shadow: 0 4px 12px rgba(0,0,0,.3) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        #${uid('panel')} {
            all: initial;
            position: fixed !important;
            bottom: 80px !important;
            right: 20px !important;
            z-index: 2147483647 !important;
            width: 360px !important;
            max-height: 70vh !important;
            background: #fff !important;
            color: #222 !important;
            border-radius: 10px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,.25) !important;
            font-size: 13px !important;
            display: none !important;
            flex-direction: column !important;
            overflow: hidden !important;
        }
        #${uid('panel')}.open {
            display: flex !important;
        }
        #${uid('header')} {
            padding: 10px 12px !important;
            background: #222 !important;
            color: #fff !important;
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            flex: 0 0 auto !important;
        }
        #${uid('list')} {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            padding: 8px !important;
            display: grid !important;
            grid-template-columns: repeat(3, 1fr) !important;
            grid-auto-rows: 1fr !important;
            gap: 8px !important;
            min-height: 0 !important;
        }
        .imgdl-item {
            all: initial;
            position: relative !important;
            display: block !important;
            width: 100% !important;
            aspect-ratio: 1 / 1 !important;
            border-radius: 6px !important;
            overflow: hidden !important;
            cursor: pointer !important;
            background: #eee !important;
            border: 2px solid transparent !important;
            user-select: none !important;
        }
        .imgdl-item > img {
            all: initial;
            display: block !important;
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
            pointer-events: none !important;
        }
        .imgdl-item.selected {
            border-color: #2ecc71 !important;
        }
        .imgdl-item.selected::after {
            content: "✓";
            position: absolute !important;
            top: 2px !important;
            right: 4px !important;
            color: #2ecc71 !important;
            font-weight: bold !important;
            font-size: 14px !important;
            text-shadow: 0 0 3px #fff, 0 0 3px #fff !important;
            pointer-events: none !important;
        }
        #${uid('footer')} {
            padding: 10px 12px !important;
            border-top: 1px solid #eee !important;
            display: flex !important;
            gap: 8px !important;
            align-items: center !important;
            justify-content: space-between !important;
            flex: 0 0 auto !important;
            background: #fafafa !important;
        }
        #${uid('footer')} button {
            all: initial;
            padding: 6px 12px !important;
            border-radius: 6px !important;
            border: 1px solid #ccc !important;
            background: #f5f5f5 !important;
            color: #222 !important;
            cursor: pointer !important;
            font-size: 13px !important;
            font-family: system-ui, sans-serif !important;
        }
        #${uid('download')} {
            background: #2ecc71 !important;
            color: #fff !important;
            border-color: #2ecc71 !important;
        }
        #${uid('empty')} {
            padding: 20px !important;
            text-align: center !important;
            color: #888 !important;
            grid-column: 1 / -1 !important;
        }
        #${uid('prefix')} {
            all: initial;
            padding: 4px 8px !important;
            border: 1px solid #ccc !important;
            border-radius: 4px !important;
            font-size: 12px !important;
            width: 90px !important;
            font-family: system-ui, sans-serif !important;
            color: #222 !important;
            background: #fff !important;
        }
    `;
    document.head.appendChild(style);

    // ===== DOM =====
    const toggleBtn = document.createElement('button');
    toggleBtn.id = uid('toggle');
    toggleBtn.textContent = '🖼';

    const panel = document.createElement('div');
    panel.id = uid('panel');
    panel.innerHTML = `
        <div id="${uid('header')}">
            <span>Images (<span id="${uid('count')}">0</span>)</span>
            <button id="${uid('rescan')}" style="background:transparent;color:#fff;border:1px solid #666;border-radius:4px;cursor:pointer;font-size:11px;padding:2px 6px;">Quét lại</button>
        </div>
        <div id="${uid('list')}"></div>
        <div id="${uid('footer')}">
            <div style="display:flex;gap:6px;align-items:center;">
                <span>Tên:</span>
                <input id="${uid('prefix')}" type="text" value="image" />
                <span id="${uid('selected-count')}">0</span>
            </div>
            <button id="${uid('download')}">Tải về</button>
        </div>
    `;

    document.body.appendChild(toggleBtn);
    document.body.appendChild(panel);

    // ===== State =====
    const selected = new Set();
    let allImages = [];

    // ===== Helpers =====
    function collectImages() {
        const set = new Set();
        document.querySelectorAll('img').forEach(img => {
            const src = img.currentSrc || img.src;
            if (src && src.startsWith('http')) set.add(src);
        });
        document.querySelectorAll('*').forEach(el => {
            const bg = getComputedStyle(el).backgroundImage;
            if (bg && bg.startsWith('url(')) {
                const url = bg.slice(5, -2).replace(/["']/g, '');
                if (url.startsWith('http')) set.add(url);
            }
        });
        return [...set];
    }

    function getExt(url) {
        try {
            const u = new URL(url);
            const name = u.pathname.split('/').pop() || '';
            const m = name.match(/\.([a-z0-9]{2,5})$/i);
            if (m) return '.' + m[1].toLowerCase();
        } catch {}
        return '.jpg';
    }

    function buildFilename(url, index, prefix) {
        const ext = getExt(url);
        return `${prefix}${index}${ext}`;
    }

    function render() {
        const list = panel.querySelector('#' + uid('list'));
        const count = panel.querySelector('#' + uid('count'));
        list.innerHTML = '';

        if (allImages.length === 0) {
            list.innerHTML = `<div id="${uid('empty')}">Không tìm thấy ảnh nào</div>`;
            count.textContent = '0';
            updateSelected();
            return;
        }

        count.textContent = allImages.length;

        allImages.forEach(url => {
            const item = document.createElement('div');
            item.className = 'imgdl-item' + (selected.has(url) ? ' selected' : '');
            item.title = url;

            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.onerror = () => { item.style.opacity = '.3'; };

            item.appendChild(img);

            // Dùng pointerdown để chắc chắn bắt được, chặn trang
            const handler = (e) => {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                if (selected.has(url)) selected.delete(url);
                else selected.add(url);
                item.classList.toggle('selected');
                updateSelected();
            };
            item.addEventListener('pointerdown', handler, true);
            item.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
            }, true);

            list.appendChild(item);
        });

        updateSelected();
    }

    function updateSelected() {
        panel.querySelector('#' + uid('selected-count')).textContent = selected.size;
    }

    async function downloadSelected() {
        if (selected.size === 0) {
            alert('Chưa chọn ảnh nào');
            return;
        }
        const prefix = panel.querySelector('#' + uid('prefix')).value.trim() || 'image';
        const urls = [...selected];
        let i = 0;
        for (const url of urls) {
            i++;
            const filename = buildFilename(url, i, prefix);
            try {
                if (typeof GM_download === 'function') {
                    await new Promise(resolve => {
                        GM_download({
                            url,
                            name: filename,
                            onload: resolve,
                            onerror: resolve
                        });
                    });
                } else {
                    const res = await fetch(url);
                    const blob = await res.blob();
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = filename;
                    a.click();
                    URL.revokeObjectURL(a.href);
                }
            } catch (e) {
                console.warn('Fail:', url, e);
            }
            await new Promise(r => setTimeout(r, 300));
        }
    }

    // ===== Events =====
    toggleBtn.addEventListener('click', () => {
        panel.classList.toggle('open');
        if (panel.classList.contains('open') && allImages.length === 0) {
            scan();
        }
    });

    panel.querySelector('#' + uid('rescan')).addEventListener('click', scan);
    panel.querySelector('#' + uid('download')).addEventListener('click', downloadSelected);

    // Chặn event từ panel lan ra trang (tránh trang bắt phím, scroll, v.v.)
    panel.addEventListener('pointerdown', e => e.stopPropagation(), true);
    panel.addEventListener('wheel', e => e.stopPropagation(), true);

    function scan() {
        allImages = collectImages();
        selected.clear();
        allImages.forEach(u => selected.add(u));
        render();
    }
})();

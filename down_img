// ==UserScript==
// @name         Image Downloader MVP
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Quét ảnh trên trang và tải về
// @match        *://*/*
// @grant        GM_download
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // ===== CSS =====
    const style = document.createElement('style');
    style.textContent = `
        #imgdl-toggle {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999999;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #222;
            color: #fff;
            border: none;
            font-size: 22px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(0,0,0,.3);
        }
        #imgdl-panel {
            position: fixed;
            bottom: 80px;
            right: 20px;
            z-index: 999999;
            width: 340px;
            max-height: 70vh;
            background: #fff;
            color: #222;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0,0,0,.25);
            font-family: system-ui, sans-serif;
            font-size: 13px;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }
        #imgdl-panel.open { display: flex; }
        #imgdl-header {
            padding: 10px 12px;
            background: #222;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        #imgdl-list {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 6px;
        }
        .imgdl-item {
            position: relative;
            aspect-ratio: 1;
            border-radius: 6px;
            overflow: hidden;
            cursor: pointer;
            background: #eee;
            border: 2px solid transparent;
        }
        .imgdl-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
        .imgdl-item.selected {
            border-color: #2ecc71;
        }
        .imgdl-item.selected::after {
            content: "✓";
            position: absolute;
            top: 2px;
            right: 4px;
            color: #2ecc71;
            font-weight: bold;
            text-shadow: 0 0 3px #fff;
        }
        #imgdl-footer {
            padding: 10px 12px;
            border-top: 1px solid #eee;
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: space-between;
        }
        #imgdl-footer button {
            padding: 6px 12px;
            border-radius: 6px;
            border: 1px solid #ccc;
            background: #f5f5f5;
            cursor: pointer;
            font-size: 13px;
        }
        #imgdl-download {
            background: #2ecc71;
            color: #fff;
            border-color: #2ecc71;
        }
        #imgdl-empty {
            padding: 20px;
            text-align: center;
            color: #888;
        }
    `;
    document.head.appendChild(style);

    // ===== DOM =====
    const toggleBtn = document.createElement('button');
    toggleBtn.id = 'imgdl-toggle';
    toggleBtn.textContent = '🖼';

    const panel = document.createElement('div');
    panel.id = 'imgdl-panel';
    panel.innerHTML = `
        <div id="imgdl-header">
            <span>Images (<span id="imgdl-count">0</span>)</span>
            <span>
                <button id="imgdl-rescan" style="background:transparent;color:#fff;border:1px solid #666;border-radius:4px;cursor:pointer;font-size:11px;padding:2px 6px;">Quét lại</button>
            </span>
        </div>
        <div id="imgdl-list"></div>
        <div id="imgdl-footer">
            <span id="imgdl-selected-count">Đã chọn: 0</span>
            <button id="imgdl-download">Tải về</button>
        </div>
    `;

    document.body.appendChild(toggleBtn);
    document.body.appendChild(panel);

    // ===== State =====
    /** @type {Set<string>} */
    const selected = new Set();
    /** @type {string[]} */
    let allImages = [];

    // ===== Helpers =====
    function collectImages() {
        const set = new Set();
        document.querySelectorAll('img').forEach(img => {
            const src = img.currentSrc || img.src;
            if (src && !src.startsWith('data:') && src.startsWith('http')) {
                set.add(src);
            }
        });
        // background-image (tùy chọn)
        document.querySelectorAll('*').forEach(el => {
            const bg = getComputedStyle(el).backgroundImage;
            if (bg && bg.startsWith('url(')) {
                const url = bg.slice(5, -2).replace(/["']/g, '');
                if (url.startsWith('http')) set.add(url);
            }
        });
        return [...set];
    }

    function guessFilename(url, index) {
        try {
            const u = new URL(url);
            let name = u.pathname.split('/').pop() || `image_${index}`;
            name = name.split('?')[0];
            if (!/\.[a-z0-9]{2,5}$/i.test(name)) name += '.jpg';
            return name;
        } catch {
            return `image_${index}.jpg`;
        }
    }

    function render() {
        const list = panel.querySelector('#imgdl-list');
        const count = panel.querySelector('#imgdl-count');
        list.innerHTML = '';

        if (allImages.length === 0) {
            list.innerHTML = '<div id="imgdl-empty">Không tìm thấy ảnh nào</div>';
            count.textContent = '0';
            updateSelected();
            return;
        }

        count.textContent = allImages.length;

        allImages.forEach(url => {
            const item = document.createElement('div');
            item.className = 'imgdl-item' + (selected.has(url) ? ' selected' : '');
            item.title = url;

            const img = document.createElement('img');
            img.src = url;
            img.loading = 'lazy';
            img.onerror = () => { item.style.opacity = '.3'; };

            item.appendChild(img);
            item.addEventListener('click', () => {
                if (selected.has(url)) selected.delete(url);
                else selected.add(url);
                item.classList.toggle('selected');
                updateSelected();
            });

            list.appendChild(item);
        });

        updateSelected();
    }

    function updateSelected() {
        panel.querySelector('#imgdl-selected-count').textContent =
            `Đã chọn: ${selected.size}`;
    }

    async function downloadSelected() {
        if (selected.size === 0) {
            alert('Chưa chọn ảnh nào');
            return;
        }
        const urls = [...selected];
        let i = 0;
        for (const url of urls) {
            i++;
            const filename = guessFilename(url, i);
            try {
                if (typeof GM_download === 'function') {
                    await new Promise(resolve => {
                        GM_download({
                            url,
                            name: filename,
                            onload: resolve,
                            onerror: resolve
                        });
                    });
                } else {
                    // fallback: fetch blob -> tải
                    const res = await fetch(url);
                    const blob = await res.blob();
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = filename;
                    a.click();
                    URL.revokeObjectURL(a.href);
                }
            } catch (e) {
                console.warn('Fail:', url, e);
            }
            // delay nhỏ để tránh bị chặn
            await new Promise(r => setTimeout(r, 300));
        }
    }

    // ===== Events =====
    toggleBtn.addEventListener('click', () => {
        panel.classList.toggle('open');
        if (panel.classList.contains('open') && allImages.length === 0) {
            scan();
        }
    });

    panel.querySelector('#imgdl-rescan').addEventListener('click', scan);
    panel.querySelector('#imgdl-download').addEventListener('click', downloadSelected);

    function scan() {
        allImages = collectImages();
        // mặc định chọn hết
        selected.clear();
        allImages.forEach(u => selected.add(u));
        render();
    }
})();
